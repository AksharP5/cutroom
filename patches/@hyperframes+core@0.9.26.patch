+/** Bakes the preview's filterable RGBA8 3D texture, in the same order as a cube. */
+export function bakeHfColorGradingTexture(grading, size, lut) {
+    const resolved = normalizeHfColorGrading(grading);
+    const grade = resolved ? compileGrade(resolved, lut) : null;
+    const data = new Uint8Array(size ** 3 * 4);
+    const step = size - 1;
+    let index = 0;
+    for (let b = 0; b < size; b += 1) {
+        for (let g = 0; g < size; g += 1) {
+            for (let r = 0; r < size; r += 1) {
+                const input = [r / step, g / step, b / step];
+                const output = grade ? gradeColor(input, grade) : input;
+                data[index++] = Math.round(output[0] * 255);
+                data[index++] = Math.round(output[1] * 255);
+                data[index++] = Math.round(output[2] * 255);
+                data[index++] = 255;
+            }
+        }
+    }
+    return data;
+}
