+import { existsSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { decodedUrlPath } from "@hyperframes/parsers/asset-paths";
+import { isPathInside } from "./assetPaths.js";
+import { isSafePath } from "../safePath.js";
+
+// Producer references are project-relative, including those in nested files.
+export function resolveCompositionSrc(projectDir, src) {
+    const rooted = (value) => resolve(projectDir, value.replace(/^(?:\.?[\\/])+/, ""));
+    const decoded = rooted(decodedUrlPath(src));
+    if (!isPathInside(decoded, projectDir)) return null;
+    const raw = rooted(src);
+    return !existsSync(decoded) && isPathInside(raw, projectDir) && existsSync(raw) ? raw : decoded;
+}
+
+// A standalone preview can also load an authored sibling when render has no root file.
+export function resolvePreviewCompositionSrc(projectDir, owner, src, onRead) {
+    if (!src || src.startsWith("//") || /^[a-z][a-z\d+.-]*:/i.test(src) || src.includes("\0")) return null;
+    const root = resolveCompositionSrc(projectDir, src);
+    if (root && isSafePath(projectDir, root)) {
+        onRead?.(root);
+        if (existsSync(root)) return { file: root, renderable: true };
+    }
+    const file = resolve(projectDir, dirname(owner), decodedUrlPath(src));
+    if (!isSafePath(projectDir, file)) return null;
+    onRead?.(file);
+    return { file, renderable: false };
+}
