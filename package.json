{
  "name": "cutroom",
  "version": "0.1.2",
  "private": true,
  "description": "A local video studio with native agents, visual review, and script editing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "vendor/@hyperframes/*"
  ],
  "scripts": {
    "postinstall": "bun run build:hyperframes",
    "build:hyperframes": "bun scripts/build-hyperframes.ts",
    "dev": "bun scripts/dev.ts",
    "start": "bun src/server/index.ts",
    "build": "bun run build:hyperframes && vite build",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "bun run build && playwright test --grep-invert @performance",
    "test:perf": "bun run build && playwright test --grep @performance",
    "desktop": "bun scripts/desktop.ts",
    "package": "bun scripts/package.ts",
    "mcp": "bun src/server/mcp/stdio.ts",
    "format": "prettier --write src scripts tests e2e *.ts *.json *.md docs",
    "format:check": "prettier --check src scripts tests e2e *.ts *.json *.md docs",
    "install:desktop": "bun scripts/install.ts",
    "bench:ui": "bun scripts/bench-ui.ts",
    "bench:transcripts": "bun scripts/bench-transcripts.ts",
    "bench:timeline": "bun scripts/bench-timeline.ts",
    "bench:media": "bun scripts/bench-media.ts",
    "bench:timeline-ui": "bun run build && CUTROOM_PERF_RUNS=3 playwright test e2e/timeline-performance.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.40.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hyperframes/core": "workspace:*",
    "@hyperframes/engine": "workspace:*",
    "@hyperframes/parsers": "workspace:*",
    "@hyperframes/producer": "workspace:*",
    "@hyperframes/studio-server": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "2.1.10",
    "acorn-walk": "8.3.5",
    "gsap": "3.15.0",
    "hono": "4.13.17",
    "hyperframes": "0.9.26",
    "lightningcss": "1.33.0",
    "linkedom": "0.18.15",
    "parse5": "8.1.1",
    "puppeteer-core": "25.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.2.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "6.4.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
