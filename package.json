{
  "name": "cutroom",
  "version": "0.1.2",
  "private": true,
  "description": "A local video studio with native agents, visual review, and script editing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun src/server/index.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "bun test tests --timeout 30000",
    "test:e2e": "bun run build && playwright test",
    "desktop": "bun scripts/desktop.ts",
    "package": "bun scripts/package.ts",
    "mcp": "bun src/server/mcp/stdio.ts",
    "format": "prettier --write src scripts tests e2e build *.ts *.json *.md docs",
    "format:check": "prettier --check src scripts tests e2e build *.ts *.json *.md docs",
    "install:desktop": "bun scripts/install.ts",
    "bench:ui": "bun scripts/bench-ui.ts",
    "bench:transcripts": "bun scripts/bench-transcripts.ts",
    "bench:timeline": "bun scripts/bench-timeline.ts",
    "bench:media": "bun scripts/bench-media.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hyperframes/core": "0.9.26",
    "@hyperframes/parsers": "0.9.26",
    "@hyperframes/producer": "0.9.26",
    "@hyperframes/studio": "0.9.26",
    "@hyperframes/studio-server": "0.9.26",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.15.0",
    "hono": "4.13.17",
    "hyperframes": "0.9.26",
    "parse5": "8.1.1",
    "puppeteer-core": "25.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.2.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "6.4.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
